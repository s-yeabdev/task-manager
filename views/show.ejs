<%- include('partials/header') %>

<div class="task-detail-container">
    <div class="page-header">
        <h1>Task Details</h1>
        <a href="/" class="btn-back">← Back to Tasks</a>
    </div>

    <div class="task-detail-card priority-<%= task.priority %>">
        <div class="task-detail-header">
            <h2><%= task.title %></h2>
            <div class="task-badges">
                <span class="priority-badge priority-<%= task.priority %>">
                    <%= task.priority %>
                </span>
                <span class="status-badge status-<%= task.status %>">
                    <%= task.status.replace('_', ' ') %>
                </span>
            </div>
        </div>

        <div class="task-detail-body">
            <div class="detail-section">
                <h3>Description</h3>
                <p><%= task.description || 'No description provided.' %></p>
            </div>

            <div class="detail-section">
                <h3>Timeline</h3>
                <p><strong>Created:</strong> <%= new Date(task.created_at).toLocaleString() %></p>
                <p><strong>Last Updated:</strong> <%= new Date(task.updated_at).toLocaleString() %></p>
            </div>
        </div>

        <div class="task-detail-actions">
            <a href="/edit/<%= task.id %>" class="btn-edit-large">✏️ Edit Task</a>
            <form action="/delete/<%= task.id %>?_method=DELETE" method="POST" style="display: inline;">
                <button type="submit" class="btn-delete-large" onclick="return confirm('Are you sure you want to delete this task?')">
                    🗑️ Delete Task
                </button>
            </form>
        </div>
    </div>
</div>

<%- include('partials/footer') %>